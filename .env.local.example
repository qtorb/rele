# Copia este archivo a .env.local para activar el MODO REAL.
# Sin este archivo (o sin ANTHROPIC_API_KEY) Relé arranca en MODO DEMO
# y analiza con reglas deterministas, sin llamar a ningún modelo.
#
# .env.local NO se commitea. La clave solo la lee el backend local (server/),
# nunca el frontend.

ANTHROPIC_API_KEY=sk-ant-...

# Opcionales
# RELE_MODEL=claude-opus-5
# RELE_PORT=8787
